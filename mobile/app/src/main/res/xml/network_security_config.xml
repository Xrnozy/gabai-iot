<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- LAN-only app: the PC on the laptop hotspot is plain HTTP and its address is found at run time, and
         this file cannot match a CIDR range, so cleartext is allowed everywhere. There is no internet traffic. -->
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
