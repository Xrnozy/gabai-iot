<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Dark Label Tape: near-black canvas, white primary tape -->
    <style name="Base.Theme.GabAi" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorPrimaryContainer">@color/primary_light</item>
        <item name="colorOnPrimaryContainer">@color/on_primary</item>
        <item name="colorError">@color/status_error</item>
        <item name="colorOutline">@color/hairline</item>

        <item name="android:colorBackground">@color/canvas</item>
        <item name="android:windowBackground">@color/canvas</item>
        <item name="colorOnBackground">@color/ink</item>
        <item name="colorSurface">@color/canvas</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="colorSurfaceVariant">@color/surface_card</item>
        <item name="colorOnSurfaceVariant">@color/body</item>

        <item name="android:statusBarColor">@color/canvas</item>
        <item name="android:navigationBarColor">@color/canvas</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>

    <style name="Theme.GabAi" parent="Base.Theme.GabAi" />
</resources>
