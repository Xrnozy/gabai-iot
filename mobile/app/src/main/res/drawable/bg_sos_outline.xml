<?xml version="1.0" encoding="utf-8"?>
<!-- SOS: outline only until focused or pressed, so it is never the loudest thing by accident. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/tape_sos" />
            <stroke android:width="@dimen/sos_outline_width" android:color="@color/focus_ring" />
            <corners android:radius="@dimen/radius_md" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/tape_sos" />
            <stroke android:width="@dimen/sos_outline_width" android:color="@color/sos_outline" />
            <corners android:radius="@dimen/radius_md" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/canvas" />
            <stroke android:width="@dimen/sos_outline_width" android:color="@color/sos_outline" />
            <corners android:radius="@dimen/radius_md" />
        </shape>
    </item>
</selector>
