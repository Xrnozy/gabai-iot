<?xml version="1.0" encoding="utf-8"?>
<!-- Quiet panel: card fill, 2dp seam; 4dp focus ring. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_card" />
            <stroke android:width="@dimen/focus_ring_width" android:color="@color/focus_ring" />
            <corners android:radius="@dimen/radius_md" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_card_elevated" />
            <stroke android:width="2dp" android:color="@color/hairline" />
            <corners android:radius="@dimen/radius_md" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_card" />
            <stroke android:width="2dp" android:color="@color/hairline" />
            <corners android:radius="@dimen/radius_md" />
        </shape>
    </item>
</selector>
