<?xml version="1.0" encoding="utf-8"?>
<!-- Clickable card/row background with a 4dp accent focus ring.
     TalkBack/keyboard focus is unmistakable; default state is a flat
     card — no shadow, no border. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_card" />
            <stroke android:width="@dimen/focus_ring_width"
                    android:color="@color/focus_ring" />
            <corners android:radius="@dimen/radius_lg" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_card_elevated" />
            <stroke android:width="@dimen/focus_ring_width"
                    android:color="@color/focus_ring" />
            <corners android:radius="@dimen/radius_lg" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_card" />
            <corners android:radius="@dimen/radius_lg" />
        </shape>
    </item>
</selector>
