<?xml version="1.0" encoding="utf-8"?>
<!-- Secondary action button: flat card fill, 4dp accent ring on focus. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_card" />
            <stroke android:width="@dimen/focus_ring_width"
                    android:color="@color/focus_ring" />
            <corners android:radius="@dimen/radius_lg" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_card_elevated" />
            <corners android:radius="@dimen/radius_lg" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_card" />
            <corners android:radius="@dimen/radius_lg" />
        </shape>
    </item>
</selector>
