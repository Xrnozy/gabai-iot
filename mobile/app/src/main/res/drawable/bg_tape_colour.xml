<?xml version="1.0" encoding="utf-8"?>
<!-- Embossed label tape strip (colour): lit top edge, shaded bottom edge, 4dp ring on focus. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/tape_colour" />
                    <stroke android:width="@dimen/focus_ring_width" android:color="@color/focus_ring" />
                    <corners android:radius="@dimen/radius_md" />
                </shape>
            </item>
            <item android:top="5dp" android:left="8dp" android:right="8dp" android:height="3dp" android:gravity="top">
                <shape android:shape="rectangle"><solid android:color="#33FFFFFF" /></shape>
            </item>
            <item android:bottom="5dp" android:left="8dp" android:right="8dp" android:height="3dp" android:gravity="bottom">
                <shape android:shape="rectangle"><solid android:color="#40000000" /></shape>
            </item>
        </layer-list>
    </item>
    <item android:state_pressed="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/tape_colour" />
                    <stroke android:width="@dimen/tape_edge" android:color="@color/tape_outline" />
                    <corners android:radius="@dimen/radius_md" />
                </shape>
            </item>
            <item android:top="5dp" android:left="8dp" android:right="8dp" android:height="3dp" android:gravity="top">
                <shape android:shape="rectangle"><solid android:color="#33FFFFFF" /></shape>
            </item>
            <item android:bottom="5dp" android:left="8dp" android:right="8dp" android:height="3dp" android:gravity="bottom">
                <shape android:shape="rectangle"><solid android:color="#40000000" /></shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#33000000" />
                    <corners android:radius="@dimen/radius_md" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/tape_colour" />
                    <stroke android:width="@dimen/tape_edge" android:color="@color/tape_outline" />
                    <corners android:radius="@dimen/radius_md" />
                </shape>
            </item>
            <item android:top="5dp" android:left="8dp" android:right="8dp" android:height="3dp" android:gravity="top">
                <shape android:shape="rectangle"><solid android:color="#33FFFFFF" /></shape>
            </item>
            <item android:bottom="5dp" android:left="8dp" android:right="8dp" android:height="3dp" android:gravity="bottom">
                <shape android:shape="rectangle"><solid android:color="#40000000" /></shape>
            </item>
        </layer-list>
    </item>
</selector>
