<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<ScrollView
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/canvas"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="140dp">

        <!-- ════════ TOP BAR ════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="@dimen/space_lg"
            android:paddingEnd="@dimen/page_margin"
            android:paddingTop="@dimen/space_lg"
            android:paddingBottom="@dimen/space_lg">

            <ImageView
                android:id="@+id/btn_color_back"
                android:layout_width="@dimen/touch_comfortable"
                android:layout_height="@dimen/touch_comfortable"
                android:padding="@dimen/space_lg"
                android:src="@drawable/ic_back_arrow"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/btn_back_desc"
                android:importantForAccessibility="yes"
                android:background="?attr/selectableItemBackgroundBorderless" />

            <TextView
                android:id="@+id/tv_color_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/space_sm"
                android:text="@string/color_title"
                android:textColor="@color/ink"
                android:textSize="@dimen/text_title"
                android:fontFamily="@font/atkinson"
                android:importantForAccessibility="yes" />

            <!-- Connecting indicator -->
            <LinearLayout
                android:id="@+id/conn_pill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_status_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:importantForAccessibility="yes"
                android:contentDescription="Connecting">

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/conn_progress"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:indeterminate="true"
                    app:indicatorColor="@color/primary"
                    app:trackThickness="2dp" />

                <TextView
                    android:id="@+id/conn_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="@string/conn_connecting"
                    android:textColor="@color/primary"
                    android:textSize="@dimen/text_small"
                    android:fontFamily="@font/atkinson" />
            </LinearLayout>

            <!-- Mic listening indicator -->
            <FrameLayout
                android:layout_width="@dimen/touch_comfortable"
                android:layout_height="@dimen/touch_comfortable">

                <ProgressBar
                    android:id="@+id/mic_loading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:indeterminate="true"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/mic_indicator"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="@dimen/space_lg"
                    android:src="@drawable/ic_mic"
                    android:visibility="gone"
                    android:contentDescription="@string/voice_listening_desc"
                    android:importantForAccessibility="yes"
                    app:tint="@color/ai_listening" />
            </FrameLayout>
        </LinearLayout>

        <!-- ════════ DETECTED COLOR — hero card ════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/page_margin"
            android:layout_marginEnd="@dimen/page_margin"
            android:layout_marginTop="@dimen/space_lg"
            android:background="@drawable/bg_card_cream"
            android:elevation="@dimen/elevation_card"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="@dimen/space_xl"
            android:minHeight="140dp">

            <!-- Live swatch — tinted from the server's RGB payload -->
            <View
                android:id="@+id/view_color_swatch"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:background="@drawable/bg_swatch" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/space_xl"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/color_detected_label"
                    android:textColor="@color/muted"
                    android:textSize="@dimen/text_small"
                    android:fontFamily="@font/atkinson"
                    android:letterSpacing="0.06" />

                <TextView
                    android:id="@+id/tv_color_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:text="@string/color_no_detection"
                    android:textColor="@color/ink"
                    android:textSize="@dimen/text_headline"
                    android:fontFamily="@font/atkinson"
                    android:accessibilityLiveRegion="polite"
                    android:importantForAccessibility="yes"
                    android:lineSpacingMultiplier="1.2" />
            </LinearLayout>
        </LinearLayout>

        <!-- ════════ ANNOUNCE COLOR (primary) ════════ -->
        <Button
            android:id="@+id/btn_color_announce"
            android:layout_width="match_parent"
            android:layout_height="@dimen/touch_comfortable"
            android:layout_marginStart="@dimen/page_margin"
            android:layout_marginEnd="@dimen/page_margin"
            android:layout_marginTop="@dimen/space_xl"
            android:background="@drawable/bg_button_primary"
            android:drawableStart="@drawable/ic_volume"
            android:drawablePadding="@dimen/space_md"
            android:gravity="center"
            android:paddingStart="@dimen/space_2xl"
            android:paddingEnd="@dimen/space_2xl"
            android:text="@string/color_announce_btn"
            android:textAllCaps="false"
            android:textColor="@color/on_primary"
            android:textSize="@dimen/text_body"
            android:fontFamily="@font/atkinson"
            android:contentDescription="@string/color_announce_btn"
            android:importantForAccessibility="yes" />

        <!-- ════════ CAMERA TARGET — slim secondary card ════════
             Frames are streamed to the server — there is no local preview.
             The card honestly tells the user what the camera is doing. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:layout_marginStart="@dimen/page_margin"
            android:layout_marginEnd="@dimen/page_margin"
            android:layout_marginTop="@dimen/space_xl"
            android:background="@drawable/bg_camera_frame"
            android:clipChildren="true"
            android:clipToPadding="true">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="@dimen/icon_xl"
                    android:layout_height="@dimen/icon_xl"
                    android:src="@drawable/ic_color"
                    android:importantForAccessibility="no"
                    app:tint="@color/icon_color" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:text="@string/color_status_ready"
                    android:textColor="@color/on_dark_muted"
                    android:textSize="@dimen/text_body"
                    android:textAlignment="center" />
            </LinearLayout>

            <!-- Scanning strip -->
            <View
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_gravity="bottom"
                android:background="@color/glow_coral" />
        </FrameLayout>

        <!-- "You said" live transcript strip — proof the mic works -->
        <include layout="@layout/view_heard_panel" />

    </LinearLayout>
</ScrollView>

<include layout="@layout/view_mic_fab" />

</FrameLayout>
