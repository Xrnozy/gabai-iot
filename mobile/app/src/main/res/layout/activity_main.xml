<?xml version="1.0" encoding="utf-8"?>
<!-- Home, Label Tape: one embossed tape strip per module, a quiet voice panel, SOS alone at the end behind a gap. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/canvas"
    android:orientation="vertical"
    tools:context=".MainActivity">

<ScrollView
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:background="@color/canvas"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/page_margin"
        android:paddingEnd="@dimen/page_margin"
        android:paddingTop="@dimen/page_margin_top"
        android:paddingBottom="@dimen/space_2xl">

        <!-- Header: greeting -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/atkinson"
                    android:importantForAccessibility="yes"
                    android:lineSpacingMultiplier="1.1"
                    android:text="@string/dashboard_greeting"
                    android:textColor="@color/ink"
                    android:textSize="@dimen/text_display"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:fontFamily="@font/atkinson"
                    android:importantForAccessibility="yes"
                    android:lineSpacingMultiplier="1.3"
                    android:text="@string/dashboard_subtitle"
                    android:textColor="@color/muted"
                    android:textSize="@dimen/text_body" />
            </LinearLayout>
        </LinearLayout>

        <!-- Voice panel -->
        <LinearLayout
            android:id="@+id/card_voice_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2xl"
            android:background="@drawable/bg_panel_focusable"
            android:orientation="vertical"
            android:padding="@dimen/space_lg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_voice_state"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:accessibilityLiveRegion="polite"
                    android:fontFamily="@font/atkinson"
                    android:text="@string/voice_state_off"
                    android:textColor="@color/ink"
                    android:textSize="@dimen/text_body_lg" />

                <!-- Mic listening indicator (honest always-on mic state;
                     pulses while "Gab" is awaiting a command) -->
                <FrameLayout
                    android:layout_width="@dimen/touch_comfortable"
                    android:layout_height="@dimen/touch_comfortable">

                    <ProgressBar
                        android:id="@+id/mic_loading"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:indeterminate="true"
                        android:visibility="gone" />

                    <ImageView
                        android:id="@+id/mic_indicator"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/voice_listening_desc"
                        android:importantForAccessibility="yes"
                        android:padding="@dimen/space_lg"
                        android:src="@drawable/ic_mic"
                        android:visibility="gone"
                        app:tint="@color/ai_listening" />
                </FrameLayout>
            </LinearLayout>

            <!-- "You said" live transcript -->
            <LinearLayout
                android:id="@+id/heard_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:importantForAccessibility="no"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/atkinson"
                    android:text="@string/heard_label"
                    android:textColor="@color/ai_listening"
                    android:textSize="@dimen/text_small"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_heard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:ellipsize="end"
                    android:fontFamily="@font/atkinson"
                    android:lineSpacingMultiplier="1.3"
                    android:maxLines="3"
                    android:text="@string/heard_idle"
                    android:textColor="@color/ink"
                    android:textSize="@dimen/text_body" />
            </LinearLayout>
        </LinearLayout>

        <!-- ════════ SOS: first strip, so it is on screen without scrolling ════════ -->
        <LinearLayout
            android:id="@+id/btn_sos"
            style="@style/GabAi.Tape"
            android:layout_marginTop="@dimen/space_2xl"
            android:background="@drawable/bg_tape_sos"
            android:contentDescription="Emergency SOS. Alerts your caregivers after a short countdown you can cancel.">

            <LinearLayout style="@style/GabAi.Tape.Labels">
                <TextView style="@style/GabAi.Tape.Title" android:text="@string/card_sos_title" />
                <TextView style="@style/GabAi.Tape.Desc" android:text="@string/card_sos_desc" />
            </LinearLayout>
            <ImageView style="@style/GabAi.Tape.Icon" android:src="@drawable/ic_sos" app:tint="@color/on_tape" />
        </LinearLayout>

        <!-- ════════ MODULE TAPE STRIPS ════════ -->
        <LinearLayout
            android:id="@+id/btn_navigation"
            style="@style/GabAi.Tape"
            android:layout_marginTop="@dimen/space_lg"
            android:background="@drawable/bg_tape_navigate"
            android:contentDescription="@string/card_nav_title">

            <LinearLayout style="@style/GabAi.Tape.Labels">
                <TextView style="@style/GabAi.Tape.Title" android:text="@string/card_nav_title" />
                <TextView style="@style/GabAi.Tape.Desc" android:text="@string/card_nav_desc" />
            </LinearLayout>
            <ImageView style="@style/GabAi.Tape.Icon" android:src="@drawable/ic_navigation" app:tint="@color/on_tape" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_family"
            style="@style/GabAi.Tape"
            android:background="@drawable/bg_tape_family"
            android:contentDescription="Family and safety. Share your location, or open the caregiver view.">

            <LinearLayout style="@style/GabAi.Tape.Labels">
                <TextView style="@style/GabAi.Tape.Title" android:text="@string/card_family_title" />
                <TextView style="@style/GabAi.Tape.Desc" android:text="@string/card_family_desc" />
            </LinearLayout>
            <ImageView style="@style/GabAi.Tape.Icon" android:src="@drawable/ic_family" app:tint="@color/on_tape" />
        </LinearLayout>

        <!-- Settings and accessible navigation: quiet panels, not tape -->
        <LinearLayout
            android:id="@+id/btn_settings"
            style="@style/GabAi.Panel"
            android:contentDescription="@string/card_settings_title">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/atkinson"
                android:text="@string/card_settings_title"
                android:textColor="@color/ink"
                android:textSize="@dimen/text_body_lg"
                android:textStyle="bold" />
            <ImageView style="@style/GabAi.Tape.Icon" android:src="@drawable/ic_settings" app:tint="@color/ink" />
        </LinearLayout>

        <TextView
            android:id="@+id/btn_access_nav"
            style="@style/GabAi.Panel"
            android:fontFamily="@font/atkinson"
            android:text="Accessible navigation: Off"
            android:textColor="@color/ink"
            android:textSize="@dimen/text_body_lg" />

    </LinearLayout>

</ScrollView>

<!-- Mic lives in its own bar so it never covers a strip while scrolling -->
<FrameLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="@dimen/space_md">
    <include layout="@layout/view_mic_fab" />
</FrameLayout>

</LinearLayout>
