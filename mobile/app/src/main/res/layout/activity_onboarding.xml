<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/onb_bg"
    android:orientation="vertical"
    android:paddingStart="@dimen/page_margin"
    android:paddingEnd="@dimen/page_margin"
    android:paddingTop="@dimen/space_lg"
    android:paddingBottom="@dimen/space_2xl"
    tools:context=".OnboardingActivity">

    <!-- Step title -->
    <TextView
        android:id="@+id/tv_onboard_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/atkinson"
        android:importantForAccessibility="yes"
        android:textColor="@color/onb_ink"
        android:textSize="@dimen/text_display"
        android:textStyle="bold"
        android:lineSpacingMultiplier="1.1" />

    <!-- Step description -->
    <TextView
        android:id="@+id/tv_onboard_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_lg"
        android:fontFamily="@font/atkinson"
        android:importantForAccessibility="yes"
        android:textColor="@color/onb_muted"
        android:textSize="@dimen/text_body_lg"
        android:lineSpacingMultiplier="1.3" />

    <!-- Hero photo — welcome step only -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/onboard_hero_card"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_marginTop="@dimen/space_xl"
        app:cardCornerRadius="@dimen/radius_lg"
        app:cardElevation="0dp">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/onboard_hero"
            android:contentDescription="@string/onboard_hero_desc"
            android:importantForAccessibility="yes" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Step content (options / status injected per step) -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="@dimen/space_2xl"
        android:overScrollMode="never"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/onboard_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <!-- Primary action -->
    <Button
        android:id="@+id/btn_onboard_primary"
        android:layout_width="match_parent"
        android:layout_height="@dimen/touch_large"
        android:layout_marginTop="@dimen/space_xl"
        android:background="@drawable/bg_btn_primary_focusable"
        android:gravity="center"
        android:text="@string/onboard_get_started"
        android:textAllCaps="false"
        android:textColor="@color/on_primary"
        android:textSize="@dimen/text_body_lg"
        android:fontFamily="@font/atkinson"
        android:importantForAccessibility="yes" />

    <!-- Secondary / skip -->
    <TextView
        android:id="@+id/btn_onboard_skip"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/touch_comfortable"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/space_sm"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:minWidth="@dimen/touch_comfortable"
        android:paddingStart="@dimen/space_lg"
        android:paddingEnd="@dimen/space_lg"
        android:text="@string/onboard_skip"
        android:textColor="@color/onb_muted"
        android:textSize="@dimen/text_body"
        android:fontFamily="@font/atkinson"
        android:importantForAccessibility="yes"
        android:visibility="gone"
        android:background="?attr/selectableItemBackground" />

</LinearLayout>
