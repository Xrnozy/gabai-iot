<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/canvas"
    android:fillViewport="true"
    android:overScrollMode="never"
    tools:context=".SettingsActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="140dp">

        <!-- ════════ TOP BAR ════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="@dimen/space_lg"
            android:paddingEnd="@dimen/page_margin"
            android:paddingTop="@dimen/space_lg"
            android:paddingBottom="@dimen/space_lg">

            <ImageView
                android:id="@+id/btn_settings_back"
                android:layout_width="@dimen/touch_comfortable"
                android:layout_height="@dimen/touch_comfortable"
                android:padding="@dimen/space_lg"
                android:src="@drawable/ic_back_arrow"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/btn_back_desc"
                android:importantForAccessibility="yes"
                android:background="?attr/selectableItemBackgroundBorderless" />

            <TextView
                android:id="@+id/tv_settings_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/space_sm"
                android:text="@string/settings_title"
                android:textColor="@color/ink"
                android:textSize="@dimen/text_title"
                android:fontFamily="@font/atkinson"
                android:importantForAccessibility="yes" />

            <!-- Mic listening indicator (honest always-on mic state) -->
            <FrameLayout
                android:layout_width="@dimen/touch_comfortable"
                android:layout_height="@dimen/touch_comfortable">

                <ProgressBar
                    android:id="@+id/mic_loading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:indeterminate="true"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/mic_indicator"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="@dimen/space_lg"
                    android:src="@drawable/ic_mic"
                    android:visibility="gone"
                    android:contentDescription="@string/voice_listening_desc"
                    android:importantForAccessibility="yes"
                    app:tint="@color/ai_listening" />
            </FrameLayout>
        </LinearLayout>

        <!-- "You said" live transcript strip — proof the mic works -->
        <include layout="@layout/view_heard_panel" />

        <!-- ════════ AUDIO ════════ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/page_margin"
            android:layout_marginTop="@dimen/space_lg"
            android:text="@string/settings_section_audio"
            android:textColor="@color/primary"
            android:textSize="@dimen/text_small"
            android:fontFamily="@font/atkinson"
            android:letterSpacing="0.08"
            android:importantForAccessibility="yes" />

        <LinearLayout
            android:id="@+id/row_mic_source"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginStart="@dimen/page_margin"
            android:layout_marginEnd="@dimen/page_margin"
            android:layout_marginTop="@dimen/space_sm"
            android:minHeight="@dimen/touch_comfortable"
            android:gravity="center_vertical"
            android:importantForAccessibility="yes"
            android:background="?attr/selectableItemBackground">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_mic_source"
                android:textColor="@color/ink"
                android:textSize="@dimen/text_body_lg"
                android:fontFamily="@font/atkinson" />

            <TextView
                android:id="@+id/tv_mic_source_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_mic_source_desc"
                android:textColor="@color/muted"
                android:textSize="@dimen/text_caption"
                android:lineSpacingMultiplier="1.3" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/row_camera_source"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginStart="@dimen/page_margin"
            android:layout_marginEnd="@dimen/page_margin"
            android:layout_marginTop="@dimen/space_sm"
            android:minHeight="@dimen/touch_comfortable"
            android:gravity="center_vertical"
            android:importantForAccessibility="yes"
            android:background="?attr/selectableItemBackground">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_camera_source"
                android:textColor="@color/ink"
                android:textSize="@dimen/text_body_lg"
                android:fontFamily="@font/atkinson" />

            <TextView
                android:id="@+id/tv_camera_source_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_camera_source_desc"
                android:textColor="@color/muted"
                android:textSize="@dimen/text_caption"
                android:lineSpacingMultiplier="1.3" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/row_output_device"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginStart="@dimen/page_margin"
            android:layout_marginEnd="@dimen/page_margin"
            android:layout_marginTop="@dimen/space_sm"
            android:minHeight="@dimen/touch_comfortable"
            android:gravity="center_vertical"
            android:importantForAccessibility="yes"
            android:background="?attr/selectableItemBackground">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_output_device"
                android:textColor="@color/ink"
                android:textSize="@dimen/text_body_lg"
                android:fontFamily="@font/atkinson" />

            <TextView
                android:id="@+id/tv_output_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_output_device_desc"
                android:textColor="@color/muted"
                android:textSize="@dimen/text_caption"
                android:lineSpacingMultiplier="1.3" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginStart="@dimen/page_margin"
            android:layout_marginEnd="@dimen/page_margin"
            android:layout_marginTop="@dimen/space_sm"
            android:minHeight="@dimen/touch_comfortable">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_speech"
                    android:textColor="@color/ink"
                    android:textSize="@dimen/text_body_lg"
                    android:fontFamily="@font/atkinson" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_speech_desc"
                    android:textColor="@color/muted"
                    android:textSize="@dimen/text_caption"
                    android:lineSpacingMultiplier="1.3" />
            </LinearLayout>

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/sw_speech"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:importantForAccessibility="yes"
                android:contentDescription="@string/settings_speech" />
        </LinearLayout>

        <!-- Speech speed -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="@dimen/page_margin"
            android:layout_marginEnd="@dimen/page_margin"
            android:layout_marginTop="@dimen/space_sm">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_speech_rate"
                android:textColor="@color/ink"
                android:textSize="@dimen/text_body_lg"
                android:fontFamily="@font/atkinson" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="@dimen/space_sm">

                <Button
                    android:id="@+id/btn_rate_slow"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/touch_comfortable"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/space_sm"
                    android:background="@drawable/bg_rate_slow"
                    android:text="@string/settings_rate_slow"
                    android:textAllCaps="false"
                    android:textColor="@color/on_primary"
                    android:maxLines="1"
                    app:autoSizeTextType="uniform"
                    app:autoSizeMinTextSize="10sp"
                    app:autoSizeMaxTextSize="18sp"
                    android:fontFamily="@font/atkinson"
                    android:importantForAccessibility="yes" />

                <Button
                    android:id="@+id/btn_rate_normal"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/touch_comfortable"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/space_sm"
                    android:background="@drawable/bg_rate_normal"
                    android:text="@string/settings_rate_normal"
                    android:textAllCaps="false"
                    android:textColor="@color/on_primary"
                    android:maxLines="1"
                    app:autoSizeTextType="uniform"
                    app:autoSizeMinTextSize="10sp"
                    app:autoSizeMaxTextSize="18sp"
                    android:fontFamily="@font/atkinson"
                    android:importantForAccessibility="yes" />

                <Button
                    android:id="@+id/btn_rate_fast"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/touch_comfortable"
                    android:layout_weight="1"
                    android:background="@drawable/bg_rate_fast"
                    android:text="@string/settings_rate_fast"
                    android:textAllCaps="false"
                    android:textColor="@color/on_primary"
                    android:maxLines="1"
                    app:autoSizeTextType="uniform"
                    app:autoSizeMinTextSize="10sp"
                    app:autoSizeMaxTextSize="18sp"
                    android:fontFamily="@font/atkinson"
                    android:importantForAccessibility="yes" />
            </LinearLayout>
        </LinearLayout>

        <!-- ════════ VOICE CONTROL ════════ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/page_margin"
            android:layout_marginTop="@dimen/space_2xl"
            android:text="@string/settings_section_voice"
            android:textColor="@color/primary"
            android:textSize="@dimen/text_small"
            android:fontFamily="@font/atkinson"
            android:letterSpacing="0.08"
            android:importantForAccessibility="yes" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginStart="@dimen/page_margin"
            android:layout_marginEnd="@dimen/page_margin"
            android:layout_marginTop="@dimen/space_sm"
            android:minHeight="@dimen/touch_comfortable">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_voice_commands"
                    android:textColor="@color/ink"
                    android:textSize="@dimen/text_body_lg"
                    android:fontFamily="@font/atkinson" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_voice_commands_desc"
                    android:textColor="@color/muted"
                    android:textSize="@dimen/text_caption"
                    android:lineSpacingMultiplier="1.3" />
            </LinearLayout>

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/sw_voice_commands"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:importantForAccessibility="yes"
                android:contentDescription="@string/settings_voice_commands" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginStart="@dimen/page_margin"
            android:layout_marginEnd="@dimen/page_margin"
            android:layout_marginTop="@dimen/space_sm"
            android:minHeight="@dimen/touch_comfortable">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_wake_name"
                    android:textColor="@color/ink"
                    android:textSize="@dimen/text_body_lg"
                    android:fontFamily="@font/atkinson" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_wake_name_desc"
                    android:textColor="@color/muted"
                    android:textSize="@dimen/text_caption"
                    android:lineSpacingMultiplier="1.3" />
            </LinearLayout>

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/sw_wake_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:importantForAccessibility="yes"
                android:contentDescription="@string/settings_wake_name" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginStart="@dimen/page_margin"
            android:layout_marginEnd="@dimen/page_margin"
            android:layout_marginTop="@dimen/space_sm"
            android:minHeight="@dimen/touch_comfortable">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_live_transcript"
                    android:textColor="@color/ink"
                    android:textSize="@dimen/text_body_lg"
                    android:fontFamily="@font/atkinson" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_live_transcript_desc"
                    android:textColor="@color/muted"
                    android:textSize="@dimen/text_caption"
                    android:lineSpacingMultiplier="1.3" />
            </LinearLayout>

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/sw_live_transcript"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:importantForAccessibility="yes"
                android:contentDescription="@string/settings_live_transcript" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginStart="@dimen/page_margin"
            android:layout_marginEnd="@dimen/page_margin"
            android:layout_marginTop="@dimen/space_sm"
            android:minHeight="@dimen/touch_comfortable">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_screen_off"
                    android:textColor="@color/ink"
                    android:textSize="@dimen/text_body_lg"
                    android:fontFamily="@font/atkinson" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_screen_off_desc"
                    android:textColor="@color/muted"
                    android:textSize="@dimen/text_caption"
                    android:lineSpacingMultiplier="1.3" />
            </LinearLayout>

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/sw_screen_off"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:importantForAccessibility="yes"
                android:contentDescription="@string/settings_screen_off" />
        </LinearLayout>

        <!-- ════════ ACCESSIBILITY ════════ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/page_margin"
            android:layout_marginTop="@dimen/space_2xl"
            android:text="@string/settings_section_accessibility"
            android:textColor="@color/primary"
            android:textSize="@dimen/text_small"
            android:fontFamily="@font/atkinson"
            android:letterSpacing="0.08"
            android:importantForAccessibility="yes" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginStart="@dimen/page_margin"
            android:layout_marginEnd="@dimen/page_margin"
            android:layout_marginTop="@dimen/space_sm"
            android:minHeight="@dimen/touch_comfortable">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_touch_explore"
                    android:textColor="@color/ink"
                    android:textSize="@dimen/text_body_lg"
                    android:fontFamily="@font/atkinson" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_touch_explore_desc"
                    android:textColor="@color/muted"
                    android:textSize="@dimen/text_caption"
                    android:lineSpacingMultiplier="1.3" />
            </LinearLayout>

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/sw_touch_explore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:importantForAccessibility="yes"
                android:contentDescription="@string/settings_touch_explore" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginStart="@dimen/page_margin"
            android:layout_marginEnd="@dimen/page_margin"
            android:layout_marginTop="@dimen/space_sm"
            android:minHeight="@dimen/touch_comfortable">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_high_contrast"
                    android:textColor="@color/ink"
                    android:textSize="@dimen/text_body_lg"
                    android:fontFamily="@font/atkinson" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_high_contrast_desc"
                    android:textColor="@color/muted"
                    android:textSize="@dimen/text_caption"
                    android:lineSpacingMultiplier="1.3" />
            </LinearLayout>

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/sw_high_contrast"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:importantForAccessibility="yes"
                android:contentDescription="@string/settings_high_contrast" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="@dimen/page_margin"
            android:layout_marginEnd="@dimen/page_margin"
            android:layout_marginTop="@dimen/space_sm">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_font_size"
                        android:textColor="@color/ink"
                        android:textSize="@dimen/text_body_lg"
                        android:fontFamily="@font/atkinson" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_font_size_desc"
                        android:textColor="@color/muted"
                        android:textSize="@dimen/text_caption"
                        android:lineSpacingMultiplier="1.3" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_font_scale_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="100%"
                    android:textColor="@color/primary"
                    android:textSize="@dimen/text_body_lg"
                    android:fontFamily="@font/atkinson"
                    android:importantForAccessibility="no" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="A"
                    android:textColor="@color/muted"
                    android:textSize="@dimen/text_caption"
                    android:fontFamily="@font/atkinson"
                    android:importantForAccessibility="no" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/slider_font_scale"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/space_md"
                    android:layout_marginEnd="@dimen/space_md"
                    android:valueFrom="0.8"
                    android:valueTo="1.6"
                    android:stepSize="0.1"
                    android:importantForAccessibility="yes"
                    android:contentDescription="@string/settings_font_size" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="A"
                    android:textColor="@color/muted"
                    android:textSize="@dimen/text_body_lg"
                    android:fontFamily="@font/atkinson"
                    android:importantForAccessibility="no" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginStart="@dimen/page_margin"
            android:layout_marginEnd="@dimen/page_margin"
            android:layout_marginTop="@dimen/space_sm"
            android:minHeight="@dimen/touch_comfortable">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_haptics"
                    android:textColor="@color/ink"
                    android:textSize="@dimen/text_body_lg"
                    android:fontFamily="@font/atkinson" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_haptics_desc"
                    android:textColor="@color/muted"
                    android:textSize="@dimen/text_caption"
                    android:lineSpacingMultiplier="1.3" />
            </LinearLayout>

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/sw_haptics"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:importantForAccessibility="yes"
                android:contentDescription="@string/settings_haptics" />
        </LinearLayout>

        <!-- ════════ VISION PROFILE ════════ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/page_margin"
            android:layout_marginTop="@dimen/space_2xl"
            android:text="@string/settings_section_vision"
            android:textColor="@color/primary"
            android:textSize="@dimen/text_small"
            android:fontFamily="@font/atkinson"
            android:letterSpacing="0.08"
            android:importantForAccessibility="yes" />

        <LinearLayout
            android:id="@+id/row_vision_profile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginStart="@dimen/page_margin"
            android:layout_marginEnd="@dimen/page_margin"
            android:layout_marginTop="@dimen/space_sm"
            android:minHeight="@dimen/touch_comfortable"
            android:gravity="center_vertical"
            android:importantForAccessibility="yes"
            android:background="?attr/selectableItemBackground">

