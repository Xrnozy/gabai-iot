    <string name="settings_wake_name">Say \"Gab\" first</string>
    <string name="settings_wake_name_desc">On: commands need the wake word, like \"Gab, walk\". Off: command words work on their own.</string>
    <string name="settings_screen_off">Screen-off listening</string>
    <string name="settings_screen_off_desc">Keep hearing \"Gab\" while the screen is off. Uses battery; a notification shows while the mic is on.</string>
    <string name="settings_live_transcript">Show what I say</string>
    <string name="settings_live_transcript_desc">Show everything the mic hears on screen. Keeps commands working even when speech detection fails. Uses battery.</string>
