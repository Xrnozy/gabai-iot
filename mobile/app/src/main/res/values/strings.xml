    <!-- ── Onboarding ── -->
    <string name="onboard_welcome_title">Welcome to GabAi</string>
    <string name="onboard_welcome_desc">GabAi describes what your camera sees, reads text out loud, and warns you about things in your way. It works best with your voice. Everything on this phone stays private.</string>
    <string name="onboard_get_started">Get started</string>
    <string name="onboard_hero_desc">A person wearing sunglasses holding a smartphone up to speak to it</string>
    <string name="onboard_vision_title">What can you see?</string>
    <string name="onboard_vision_desc">Pick the one that sounds most like you. GabAi will warn you about things hiding in the spots you can\'t see.</string>
    <string name="onboard_vision_left">Blurry on my left</string>
    <string name="onboard_vision_left_desc">I can\'t see well on my left side</string>
    <string name="onboard_vision_right">Blurry on my right</string>
    <string name="onboard_vision_right_desc">I can\'t see well on my right side</string>
    <string name="onboard_vision_tunnel">Tunnel vision</string>
    <string name="onboard_vision_tunnel_desc">I only see the middle, not the sides</string>
    <string name="onboard_vision_central">Blurry center</string>
    <string name="onboard_vision_central_desc">I see the sides, but the middle is blurry</string>
    <string name="onboard_vision_all">Little or no vision</string>
    <string name="onboard_vision_all_desc">Tell me about everything around me</string>
    <string name="onboard_permissions_title">Camera and microphone</string>
    <string name="onboard_permissions_desc">GabAi needs the camera to see for you, and the microphone to hear \"Gab\" commands. Your video and voice stay on this device.</string>
    <string name="onboard_allow">Allow permissions</string>
    <string name="onboard_explore_title">Explore by touch</string>
    <string name="onboard_explore_desc">Hold your finger on anything and Gab reads what it is. You will feel a little buzz when you touch something it can read. Turn it off anytime in Settings, under Accessibility.</string>
    <string name="onboard_skip">Skip</string>
    <string name="onboard_finish">Finish</string>
    <string name="onboard_continue">Continue</string>
    <string name="onboard_back">Back</string>

