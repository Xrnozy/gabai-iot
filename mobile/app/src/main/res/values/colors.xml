<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ==================================================================
         GabAi tokens, Label Tape world, LIGHT (system light setting).
         Cool near-white ground, ink-black primary tape. Tape module hues
         are identical to dark so colour keeps meaning across themes; amber
         and others gain a 2dp ink edge (tape_outline) to separate from the
         light ground. Same name set as values-night/colors.xml.
         ================================================================== -->
    <color name="black">#FF000000</color>
    <color name="white">#FFFFFFFF</color>

    <!-- ── Surfaces ── -->
    <color name="canvas">#FFF5F6F8</color>
    <color name="canvas_secondary">#FFE9EBEF</color>
    <color name="surface_card">#FFFFFFFF</color>
    <color name="surface_card_elevated">#FFFFFFFF</color>
    <color name="surface_dark">#FF0E0F12</color>
    <color name="surface_dark_elevated">#FF1A1C21</color>
    <color name="surface_dark_card">#FF23252B</color>

    <!-- ── Seams ── -->
    <color name="hairline">#FF7A7F8A</color>
    <color name="hairline_dark">#FF646872</color>

    <!-- ── Text ── -->
    <color name="ink">#FF0E0F12</color>            <!-- 17.7:1 on canvas -->
    <color name="body">#FF2A2D33</color>           <!-- 12.8:1 -->
    <color name="muted">#FF4B505A</color>          <!--  7.5:1 -->
    <color name="on_dark">#FFFFFFFF</color>
    <color name="on_dark_soft">#FFE4E6EB</color>
    <color name="on_dark_muted">#FFA9AEB8</color>

    <!-- ── Primary = ink tape with white text ── -->
    <color name="primary">#FF0E0F12</color>
    <color name="primary_light">#FF2A2D33</color>
    <color name="primary_active">#FF000000</color>
    <color name="primary_soft">#140E0F12</color>
    <color name="on_primary">#FFFFFFFF</color>
    <color name="focus_ring">#FF1F3FB8</color>      <!-- 7.9:1 on canvas -->

    <!-- ── Semantic ── -->
    <color name="status_success">#FF13703A</color>  <!-- 5.7:1 -->
    <color name="status_warning">#FF8A5300</color>  <!-- 5.9:1 -->
    <color name="status_error">#FFB3261E</color>    <!-- 6.0:1 -->
